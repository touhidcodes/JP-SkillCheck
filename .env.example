# ── Google Sheets ─────────────────────────────────────────────────────────────
# Service account credentials JSON (stringified)
GOOGLE_SERVICE_ACCOUNT_JSON=''
# The spreadsheet ID from the Google Sheets URL
GOOGLE_SPREADSHEET_ID=

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Cron ───────────────────────────────────────────────────────────────────────
# Secret used to authenticate calls to /api/cron/daily and /api/cron/weekly
CRON_SECRET=

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Used for risk alert emails, absent notices, and weekly mentor reports
RESEND_API_KEY=

# ── App URL ────────────────────────────────────────────────────────────────────
# Used by the daily cron to call the weekly cron endpoint on Mondays
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional Notifications ─────────────────────────────────────────────────────
# Email address displayed in 'From' field for outgoing messages
EMAIL_FROM=
# Slack/Discord webhook URL for notifications
WEBHOOK_URL=

# ── AI Interview ──────────────────────────────────────────────────────────────
# Students provide their own Gemini API key. This only selects the scoring model.
GEMINI_INTERVIEW_MODEL=gemini-2.5-flash
